{
  "name": "forma-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "parity": "vitest run --config vitest.parity.config.ts",
    "sample": "node scripts/make-sample.mjs",
    "brand": "node scripts/make-brand.mjs",
    "e2e": "node tests/e2e/acceptance.mjs e2e-shots && node tests/e2e/reshape.mjs e2e-shots && node tests/e2e/phase2.mjs e2e-shots && node tests/e2e/sheets.mjs e2e-shots && node tests/e2e/shell.mjs e2e-shots",
    "check": "tsc -b --noEmit && vitest run && vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
